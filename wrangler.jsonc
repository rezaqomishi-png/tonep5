{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tonep5",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "5518e920-1777-4914-bdb6-4532576f37f8","database_name": "web-app99" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "1c00acf7dc364ffe85f2037ca1c34c39" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
